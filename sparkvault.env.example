# Secrets and settings for docker-compose.yml. Copy to sparkvault.env next to the compose file
# (scripts/init-env.sh does this and generates the secrets), fill it in, and chmod 600 it.
# The name is visible on purpose: some NAS UIs hide files that start with a dot.
# No quotes around values. Host folders, port and uid/gid are NOT here: they are inline in docker-compose.yml.

# Required. The app will not start while these are empty.
# 32+ random characters:   openssl rand -hex 32
SPARKVAULT_SECRET_KEY=
# One line starting with scrypt:   python3 -m app.hashpw   (prompts for a password)
SPARKVAULT_ADMIN_HASH=

# Optional. Empty = result upload off. To turn it on (32+ characters): openssl rand -hex 32
SPARKVAULT_INGEST_TOKEN=

# Node names for the filter and for result records, comma separated
SPARKVAULT_NODES=node-a,node-b

# Set to 1 only once the app is served over HTTPS
SPARKVAULT_COOKIE_SECURE=0
