# Copy to .env (git-ignored) and fill in. Never commit the real file.
# scripts/init-env.sh writes this for you and generates the secrets.

# --- Required secrets ---
# 32+ random characters:   openssl rand -hex 32
SPARKVAULT_SECRET_KEY=
# From:  python3 -m app.hashpw      (prompts for a password; stdlib only; no quotes needed)
SPARKVAULT_ADMIN_HASH=

# --- Required host folders (absolute paths on the machine running Docker) ---
# Folder holding your library.yaml and results/ (start from examples/ in this repo).
SPARKVAULT_CATALOGUE_HOST_DIR=
# Hugging Face cache root, the folder that contains hub/models--<org>--<name>.
SPARKVAULT_HF_HOST_DIR=

# --- Optional ---
# Names offered in the node filter and accepted in result records (comma separated).
SPARKVAULT_NODES=node-a,node-b
# Writable folder for uploaded result records (default ./inbox next to docker-compose.yml).
# SPARKVAULT_INBOX_HOST_DIR=./inbox
# Enables POST /api/results when set (32+ characters: openssl rand -hex 32). Empty = upload off.
SPARKVAULT_INGEST_TOKEN=
# Host port, and the uid/gid the container runs as (see the comment in docker-compose.yml).
# SPARKVAULT_PORT=8080
# SPARKVAULT_UID=10001
# SPARKVAULT_GID=10001
# Set to 1 once the app is served over HTTPS.
SPARKVAULT_COOKIE_SECURE=0
# Pin the build to a tag or commit instead of main.
# SPARKVAULT_BUILD_CONTEXT=https://github.com/jmoe24/sparkvault.git#main
