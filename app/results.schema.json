{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "SparkVault result record",
  "description": "One benchmark/eval/replay run of one model on one node (or node pair). Files live in <catalogue>/results/<date>-<node>-<label>.json and are committed to git. Every measurement block is optional: a run records only what was measured. Never put a prompt text, an API key or any other secret in a result file.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "date",
    "model",
    "node",
    "topology",
    "validity",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "Same as the file name without .json: <date>-<node>-<label>."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "model": {
      "type": "string",
      "description": "The `id` of an entry in library.yaml."
    },
    "node": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(\\+[A-Za-z0-9._-]+)*$",
      "description": "Node name as you use it in SPARKVAULT_NODES; join two with + for a multi-node run, e.g. node-a+node-b."
    },
    "topology": {
      "enum": [
        "single",
        "tp2",
        "tp2-ray"
      ]
    },
    "label": {
      "type": "string",
      "description": "Short human label for the run, e.g. 'baseline', 'clock-fix', 'ray'."
    },
    "validity": {
      "enum": [
        "ok",
        "suspect"
      ],
      "description": "'suspect' = a known fault was present (e.g. a GPU clock clamp). Suspect runs are shown but never used as a headline number."
    },
    "validity_note": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "launch_script": {
          "type": "string",
          "description": "Repo path of the script that started the container."
        },
        "flags_note": {
          "type": "string",
          "description": "Free text. Prefer `overrides` for anything that changed a flag."
        },
        "model_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "gpu_sm_clock_mhz": {
          "type": "integer",
          "minimum": 0
        },
        "container": {
          "type": "string",
          "description": "Name of the container that ran the model."
        },
        "overrides": {
          "type": "array",
          "description": "Flags changed from the model's recipe for this run (an experiment). Empty or absent = the recipe as committed. More than one entry = a multi-variable run, which the UI warns about variable at a time).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flag"
            ],
            "properties": {
              "flag": {
                "type": "string",
                "pattern": "^--"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Recipe value; null when the flag was added."
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Value used; null when the flag was removed."
              }
            }
          }
        },
        "startup_s": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds from container start to 'Application startup complete'."
        },
        "recipe_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "Git commit of library.yaml that the recipe was read from. Overrides are on top of this; they are not in git."
        }
      }
    },
    "bench": {
      "type": "object",
      "description": "tools/bench-vllm.sh output.",
      "additionalProperties": false,
      "properties": {
        "single_stream_tok_s": {
          "type": "number",
          "minimum": 0
        },
        "concurrent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "num_prompts": {
              "type": "integer",
              "minimum": 1
            },
            "output_tok_s": {
              "type": "number",
              "minimum": 0
            },
            "total_tok_s": {
              "type": "number",
              "minimum": 0
            },
            "mean_ttft_ms": {
              "type": "number",
              "minimum": 0
            },
            "mean_tpot_ms": {
              "type": "number",
              "minimum": 0
            },
            "p99_itl_ms": {
              "type": "number",
              "minimum": 0
            },
            "failed_requests": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "spec_decode_acceptance_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "eval": {
      "type": "object",
      "description": "Judge-scored prompt-set output.",
      "additionalProperties": false,
      "properties": {
        "prompt_set": {
          "type": "string"
        },
        "judge": {
          "type": "string"
        },
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "per_category": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "description": "Real tool calls returned from a captured agent request.",
      "additionalProperties": false,
      "required": [
        "tool_call_pass",
        "tool_call_total"
      ],
      "properties": {
        "tool_call_pass": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call_total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "string",
      "description": "Where the numbers came from: the tuning-log heading, or the raw output file for runs made after this schema."
    }
  }
}
